{
  "name": "@mcpware/cross-code-organizer",
  "version": "0.20.0",
  "description": "Cross-Code Organizer (CCO, formerly Claude Code Organizer) — manage AI coding tool configs across Claude Code, Codex CLI, OpenCode, DeepSeek Harness, and more. Memories, skills, MCP servers, commands, agents, rules, and hooks across global and project scopes",
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "!src/session-distiller-v2.mjs",
    "!src/session-distiller-v3.mjs",
    "!src/session-distiller-v4.mjs",
    "!src/session-distiller-v5.mjs",
    "LICENSE",
    "PRIVACY.md",
    "README.md"
  ],
  "bin": {
    "cross-code-organizer": "bin/cli.mjs"
  },
  "scripts": {
